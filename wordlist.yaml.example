# ============================================================
# wordlist.yaml 范例文件
# ============================================================
#
# 结构说明：
#   顶层 key    → 语言代码（用于 Google TTS 发音）
#   第二层 key  → 单词类型（决定使用的卡片模板）
#   最内层      → 单词列表（字符串数组）
#
# 常用语言代码：
#   en - 英语（默认）
#   zh - 中文
#   ja - 日语
#   de - 德语
#   fr - 法语
#
# 单词类型：
#   default → 标准 Cloze 填空卡片（5个例句）
#   名词    → 简化的正反面卡片（1个例句）
#
# 辨析模式：
#   compare → 单词辨析，每组至少2个单词，生成对比卡片
#
# ============================================================

# ------------------
# 英语单词
# ------------------
en:
  # 标准类型：使用 ShuffledCloze 模板
  # 特点：5个例句，单词在例句中用 {{c1::word}} 标记
  default:
    - savvy
    - tribulation
    - epiphany
    - serendipity
    # 可以添加注释行（以 # 开头的行会被忽略）
    - ephemeral

  # 名词类型：使用「基础」模板
  # 特点：1个例句，正反面格式
  名词:
    - dough
    - resilience

  # 辨析模式：对比相似单词的用法差异
  # 每组至少2个单词，为每个词生成5个例句卡片
  # 卡片格式：填空选择 + 词语辨析说明
  compare:
    - [fission, fissure]
    - [predicament, plight]
    - [affect, effect, impact]  # 支持超过2个单词

# ------------------
# 中文单词
# ------------------
zh:
  default:
    - 悠然自得
    - 心领神会

# ------------------
# 日语单词示例
# ------------------
ja:
  default:
    - 侘寂
    - 生きがい
